<mujoco model="piper_dual_capstone">
  <!-- capstone 프레임(베이스/아크릴/목 2-DOF/헤드) + Agilex Piper 양팔(piper_dual.xml 원문 이식).
       프레임·목·팔 장착 xy 좌표는 capstone_mujoco/urdf_v8_mujoco.xml의 실측 CAD 값.
       팔 base 높이: capstone 1번 조인트 z=0.826에서 Piper joint1 오프셋 0.123을 빼서 z=0.703.
       ⚠️ 팔 base의 yaw(장착 방향)는 실물 미확인 — 아래 left/right_base_link quat 수정 필요 시 교체. -->
  <compiler angle="radian" meshdir="assets"/>

  <!-- 조명: 그림자 off 유지하되, 주변광을 낮추고 방향광 비중을 높여 면 음영(경계감) 확보 -->
  <visual>
    <headlight diffuse="0.4 0.4 0.4" ambient="0.18 0.18 0.18" specular="0.15 0.15 0.15"/>
  </visual>

  <!-- noslip: 파지 중 접촉면이 서서히 미끄러지는 수치 드리프트 억제 -->
  <option integrator="implicitfast" cone="elliptic" impratio="100" noslip_iterations="10"/>

  <default>
    <default class="piper">
      <joint frictionloss="0.3" armature="0.005"/>
      <position inheritrange="1" forcerange="-100 100"/>
      <default class="finger">
        <joint frictionloss="0" type="slide"/>
        <position forcerange="-10 10"/>
      </default>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0" density="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="capsule"/>
      </default>
    </default>
  </default>


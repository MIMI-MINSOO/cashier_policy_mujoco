      <!-- 표시등은 group 5: 관측 카메라 렌더(get_obs, group 0~2만 표시)에는 안 찍히고
           teleop 뷰어에서만 group 5를 켜서 사람에게만 보임 (학습 데이터 오염 방지) -->
      <geom name="scanner_indicator" type="box" size="0.012 0.05 0.003" pos="-0.478 0.40 0.7586" rgba="0.35 0.35 0.35 1" contype="0" conaffinity="0" group="5"/>

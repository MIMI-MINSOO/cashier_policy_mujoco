  <equality>
    <!-- 실물 그리퍼는 기어 강결합 — 커플링을 거의 강체로 (기본 soft 제약이면 접촉 시
         수동 손가락이 밀려 비대칭 파지/비틀림 이탈 발생) -->
    <joint joint1="left_joint8"  joint2="left_joint7"  polycoef="0 -1 0 0 0" solref="0.002 1" solimp="0.99 0.999 0.0001"/>
    <joint joint1="right_joint8" joint2="right_joint7" polycoef="0 -1 0 0 0" solref="0.002 1" solimp="0.99 0.999 0.0001"/>
